{# LUXE footer: wordmark + description · footer menu · customer care (contacts) · social/apps; payments + copyright row.
   Every block comes from merchant data via Twilight components — nothing here is hardcoded content. #}
{% set lx_wordmark = theme.settings.get('lx_wordmark', 'MAISON D7') %}
<footer data-testid="store-footer" class="store-footer lx-footer">
  <div aria-label="footer" class="store-footer__inner lx-footer__inner">
    <div class="lx-footer__grid">
      <div class="lx-footer__brand">
        <a href="{{ link('/') }}" class="lx-footer__word">
          {% if lx_wordmark %}{{ lx_wordmark }}{% else %}<h3>{{ store.name }}</h3>{% endif %}
        </a>
        {% if store.description %}
          <div class="lx-footer__desc">{{ store.description|raw }}</div>
        {% endif %}

        <div class="lx-footer__trust">
          <salla-trust-badges data-testid="store-footer-trust-badges"></salla-trust-badges>
          {% if store.settings.tax.number %}
            <div class="lx-footer__tax">
              {% if store.settings.tax.certificate %}
                <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                  <img width="40" height="50" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" alt="value added tax">
                </a>
              {% endif %}
              <div>
                <p>{{ trans('common.elements.tax_number') }}</p>
                <b>{{ store.settings.tax.number }}</b>
              </div>
            </div>
            {% if store.settings.tax.certificate %}
              <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
                <div class="flex justify-center max-w-full">
                  <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
                </div>
              </salla-modal>
            {% endif %}
          {% endif %}
        </div>
      </div>

      <div class="lx-footer__col">
        <h3 class="lx-footer__title">{{ trans('blocks.footer.pages_links') }}</h3>
        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
      </div>

      <div class="lx-footer__col">
        <h3 class="lx-footer__title">{{ trans('blocks.luxe.customer_care') }}</h3>
        <salla-contacts data-testid="store-footer-contacts"></salla-contacts>
      </div>

      <div class="lx-footer__col">
        <h3 class="lx-footer__title">{{ trans('blocks.luxe.follow') }}</h3>
        <salla-social data-testid="store-footer-social" class="lx-footer__social"></salla-social>
        <salla-apps-icons data-testid="store-footer-apps" class="lx-footer__apps"></salla-apps-icons>
      </div>
    </div>
  </div>

  <div class="lx-footer__bottom">
    <span class="copyright-text">{% hook copyright %}</span>
    <salla-payments data-testid="store-footer-payments"></salla-payments>
  </div>
</footer>
