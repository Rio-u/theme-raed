{#
| component.eyebrow          | ?string   |                                                          |
| component.title            | string    |                                                          |
| component.text             | ?string   | Short line under the title                               |
| component.products         | Product[] | Optional hand-picked products (wins over the toggles)    |
| component.best_sellers     | bool      | Salla's best-selling source                              |
| component.on_sale          | bool      | Only discounted products (Salla "offers" source)         |
| component.as_slider        | bool      | Horizontal slider instead of a grid                      |
| component.limit            | ?int      | How many products (default 8)                            |
| component.display_all_url  | ?string   | variable-list link                                       |
#}
{% set limit = component.limit|default(8) %}
{% if component.products|length %}
  {% set source = 'selected' %}
  {% set source_value = '[' ~ component.products|map(p => p.id)|join(',') ~ ']' %}
{% elseif component.on_sale %}
  {% set source = 'offers' %}
  {% set source_value = '' %}
{% else %}
  {% set source = component.best_sellers ? 'sales' : 'latest' %}
  {% set source_value = '' %}
{% endif %}
{% set display_all = component.display_all_url %}

<section component-id="{{ componentId }}" data-testid="store-home-luxe-products"
         class="s-block lx-section lx-products {{ component.as_slider ? 'lx-products--slider' : '' }}">
  <div class="lx-wrap">
    <header class="lx-section-head" data-lx-reveal>
      <div>
        {% if component.eyebrow %}<span class="lx-eyebrow">{{ component.eyebrow }}</span>{% endif %}
        <h2 class="lx-section-head__title">{{ component.title }}</h2>
        {% if component.text %}<p class="lx-section-head__text">{{ component.text }}</p>{% endif %}
      </div>
      {% if display_all and display_all != '#' %}
        <a href="{{ display_all }}" class="lx-link">{{ trans('blocks.luxe.view_all') }}</a>
      {% endif %}
    </header>

    {% if component.as_slider %}
      <salla-products-slider class="lx-products__slider"
          source="{{ source }}"
          {% if source_value %}source-value="{{ source_value }}"{% endif %}
          limit="{{ limit }}"
          slider-id="lx-products-{{ position }}"
          block-title=" "></salla-products-slider>
    {% else %}
      <salla-products-list class="lx-products__list"
          source="{{ source }}"
          {% if source_value %}source-value="{{ source_value }}"{% endif %}
          limit="{{ limit }}"></salla-products-list>
    {% endif %}
  </div>
</section>
