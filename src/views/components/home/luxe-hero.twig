{#
Campaign hero — one markup, six layouts chosen in the editor (component.layout):
  gallery    one framed image, quiet caption underneath (default)
  split      half image, half ivory with the headline
  editorial  oversized headline above a wide image
  arch       arched image with a small detail photo, text beside it
  triptych   three portrait images, headline over them
  full       one full-bleed image, headline over it
| component.layout           | items   | dropdown value                                        |
| component.image            | string  |                                                       |
| component.image_2          | ?string | triptych frame 2 / arch detail photo                  |
| component.image_3          | ?string | triptych frame 3                                      |
| component.eyebrow          | ?string |                                                       |
| component.title            | string  |                                                       |
| component.title_en         | ?string | Latin serif line                                      |
| component.text             | ?string |                                                       |
| component.cta_text         | ?string |                                                       |
| component.cta_url          | ?string | variable-list link                                    |
#}
{% set raw = component.layout %}
{% if raw.value is defined %}
  {% set lay = raw.value %}
{% elseif raw is iterable and raw|length and (raw|first).value is defined %}
  {% set lay = (raw|first).value %}
{% else %}
  {% set lay = raw %}
{% endif %}
{# sections saved before the layout field existed #}
{% if not lay %}
  {% set lay = component.full_bleed ? 'full' : (component.layout_split ? 'arch' : 'triptych') %}
{% endif %}
{% if lay not in ['gallery', 'split', 'editorial', 'arch', 'triptych', 'full'] %}{% set lay = 'gallery' %}{% endif %}

{% set has_cta = component.cta_text and component.cta_url and component.cta_url != '#' %}
{% set img2 = component.image_2|default(component.image) %}
{% set img3 = component.image_3|default(img2) %}

<section component-id="{{ componentId }}" data-testid="store-home-luxe-hero" data-lx-hero
         class="s-block lx-hero2 lx-hero2--{{ lay }}">
  <div class="lx-h2__media">
    <figure class="lx-h2__img lx-h2__img--1" style="--f:0">
      <img src="{{ component.image }}" alt="{{ component.title }}" fetchpriority="high" loading="eager">
    </figure>
    <figure class="lx-h2__img lx-h2__img--2" style="--f:1"><img src="{{ img2 }}" alt="" loading="eager"></figure>
    <figure class="lx-h2__img lx-h2__img--3" style="--f:2"><img src="{{ img3 }}" alt="" loading="eager"></figure>
  </div>

  <div class="lx-h2__content">
    {% if component.eyebrow %}<span class="lx-h2__eyebrow lx-hero__line" style="--l:0">{{ component.eyebrow }}</span>{% endif %}
    <h2 class="lx-h2__title">
      <span class="lx-hero__mask"><span class="lx-hero__line" style="--l:1">{{ component.title }}</span></span>
    </h2>
    {% if component.title_en %}
      <p class="lx-h2__en" lang="en"><span class="lx-hero__line" style="--l:2">{{ component.title_en }}</span></p>
    {% endif %}
    {% if component.text %}<p class="lx-h2__text lx-hero__line" style="--l:3">{{ component.text }}</p>{% endif %}
    {% if has_cta %}
      <a href="{{ component.cta_url }}" class="lx-h2__cta lx-hero__line" style="--l:4">
        <span>{{ component.cta_text }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {% endif %}
  </div>
</section>
<span id="lx-after-hero"></span>
