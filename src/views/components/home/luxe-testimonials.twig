{#
Customer voices — one large quote at a time, cross-fading, with arrows and a counter.
Written quotes by default; switch on real_reviews to show the store's Salla ratings instead.
| component.eyebrow          | ?string  |                                         |
| component.title            | ?string  |                                         |
| component.real_reviews     | bool     | Use <salla-reviews> (store ratings)     |
| component.limit            | ?int     | Number of real reviews (default 8)      |
| component.items[].text     | string   |                                         |
| component.items[].name     | string   |                                         |
| component.items[].meta     | ?string  | e.g. city or the product she bought     |
#}
<section component-id="{{ componentId }}" data-testid="store-home-luxe-testimonials" class="s-block lx-section lx-voices">
  <div class="lx-wrap">
    {% if not component.real_reviews and component.items|length %}
      {% set total = component.items|length %}
      <div class="lx-quote" data-lx-quotes>
        <header class="lx-quote__head" data-lx-reveal>
          {% if component.eyebrow %}<span class="lx-eyebrow">{{ component.eyebrow }}</span>{% endif %}
          {% if component.title %}<h2 class="lx-quote__heading">{{ component.title }}</h2>{% endif %}
        </header>

        <span class="lx-quote__mark" aria-hidden="true">&ldquo;</span>

        <div class="lx-quote__stage" aria-live="polite">
          {% for item in component.items %}
            <figure class="lx-quote__slide {{ loop.first ? 'is-active' : '' }}" data-i="{{ loop.index0 }}" {{ loop.first ? '' : 'aria-hidden="true"' }}>
              <blockquote class="lx-quote__text">{{ item.text }}</blockquote>
              <figcaption class="lx-quote__by">
                <span class="lx-quote__stars" aria-hidden="true">★★★★★</span>
                <span class="lx-quote__name">{{ item.name }}</span>
                {% if item.meta %}<span class="lx-quote__meta">{{ item.meta }}</span>{% endif %}
              </figcaption>
            </figure>
          {% endfor %}
        </div>

        {% if total > 1 %}
          <div class="lx-quote__nav">
            <button type="button" class="lx-arrow" data-dir="prev" aria-label="previous">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <span class="lx-quote__count"><b data-lx-q-current>01</b> / {{ '%02d'|format(total) }}</span>
            <button type="button" class="lx-arrow" data-dir="next" aria-label="next">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% else %}
      <header class="lx-voices__head" data-lx-reveal>
        {% if component.eyebrow %}<span class="lx-eyebrow">{{ component.eyebrow }}</span>{% endif %}
        {% if component.title %}<h2 class="lx-section-head__title">{{ component.title }}</h2>{% endif %}
      </header>
      <salla-reviews class="lx-voices__reviews" type="store" sort="latest" limit="{{ component.limit|default(8) }}"></salla-reviews>
    {% endif %}
  </div>
</section>
