LUXE header: announcement bar + one bar (menu · logo · actions) + centred navigation row.
#mainnav / .inner / a.mburger / custom-main-menu are kept: app.js sticky + mobile menu hook into them.
#}
{% set lx_wordmark = theme.settings.get('lx_wordmark', 'MAISON') %}
{% set lx_announcement = theme.settings.get('lx_announcement', 'موسم جديد — اكتشفي المجموعة الجديدة') %}
{% set lx_announcement_url = theme.settings.get('lx_announcement_url') %}

<header data-testid="store-header" class="store-header lx-header">

  {% if lx_announcement %}
    <div class="lx-announce" role="region" aria-label="{{ trans('blocks.luxe.announcement') }}">
      <div class="lx-announce__inner">
        {% if lx_announcement_url %}
          <a href="{{ lx_announcement_url }}" class="lx-announce__text">{{ lx_announcement }}</a>
        {% else %}
          <span class="lx-announce__text">{{ lx_announcement }}</span>
        {% endif %}
        <div class="lx-announce__tools">
          <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
          {% if store.scope %}
            <button class="lx-announce__btn" type="button"
                    onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
              <i class="sicon-location" aria-hidden="true"></i> {{ store.scope.name }}
            </button>
          {% endif %}
          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <div id="mainnav" class="main-nav-container lx-mainnav">
    <div class="inner">
      {# One row. Desktop: brand · navigation · actions. Mobile: menu+search · brand · actions. #}
      <div class="lx-bar">
        <div class="lx-bar__start">
          <a data-testid="store-header-mobile-toggle" class="mburger lx-icon-btn lx-only-mobile" href="#mobile-menu" aria-label="Open-menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3.5 7.5h17M3.5 12h11M3.5 16.5h17" stroke-linecap="round"/></svg>
          </a>
          <button type="button" class="lx-icon-btn lx-bar__search lx-only-mobile" aria-label="{{ trans('blocks.luxe.search') }}"
                  onclick="salla.event.dispatch('search::open')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2" stroke-linecap="round"/></svg>
          </button>
        </div>

        <a data-testid="store-header-logo" class="navbar-brand lx-brand" href="{{ store.url }}">
          {% if lx_wordmark %}
            <span class="lx-brand__word">{{ lx_wordmark }}</span>
          {% else %}
            <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
          {% endif %}
          {% if is_page('index') %}
            <h1 class="sr-only">{{ store.name }}</h1>
          {% else %}
            <h2 class="sr-only">{{ store.name }}</h2>
          {% endif %}
        </a>

        <nav class="lx-nav" aria-label="main">
          <custom-main-menu></custom-main-menu>
        </nav>

        <div class="lx-bar__end">
          <button type="button" class="lx-icon-btn lx-only-desktop" aria-label="{{ trans('blocks.luxe.search') }}"
                  onclick="salla.event.dispatch('search::open')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2" stroke-linecap="round"/></svg>
          </button>
          {% if theme.settings.get('lx_dark_toggle', true) %}
            <button type="button" class="lx-icon-btn lx-theme-toggle" data-lx-theme-toggle aria-pressed="false"
                    aria-label="{{ trans('blocks.luxe.dark_mode') }}">
              <svg class="lx-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"/></svg>
              <svg class="lx-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/></svg>
            </button>
          {% endif %}
          <salla-user-menu data-testid="store-header-user-menu" class="lx-user" avatar-only show-header show-trigger></salla-user-menu>
          <a href="{{ link('wishlist') }}" class="lx-icon-btn lx-only-desktop" aria-label="{{ trans('blocks.luxe.wishlist') }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 20s-7.5-4.4-7.5-10A4.2 4.2 0 0 1 12 7.4 4.2 4.2 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10z" stroke-linejoin="round"/></svg>
          </a>
          <salla-cart-summary data-testid="store-header-cart" class="lx-cart">
            <span slot="icon" class="lx-cart__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5.5 8.5h13l-1 11.5h-11z" stroke-linejoin="round"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/></svg>
            </span>
          </salla-cart-summary>
        </div>
      </div>
    </div>
  </div>
</header>
