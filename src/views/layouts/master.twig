{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |     
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    {# LUXE: decide before first paint whether the intro plays (once per session, never inside the editor iframe) #}
    <script data-cfasync="false">
        (function (d) {
            var h = d.documentElement, seen = false, saved = null;
            h.className += ' lx-js';
            // colour scheme: visitor's choice > merchant default ('light' | 'dark' | 'system')
            try { saved = localStorage.getItem('lx-theme'); } catch (e) {}
            var mode = saved || '{{ theme.settings.get('lx_color_mode', 'light') }}';
            if (mode === 'dark' || (mode === 'system' && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches)) h.className += ' lx-dark';
            {% if not theme.settings.get('lx_cursor', true) %}h.setAttribute('data-lx-cursor', 'off');{% endif %}
            try { seen = sessionStorage.getItem('lx-intro-seen') === '1'; } catch (e) {}
            if (seen || window.self !== window.top) h.className += ' lx-intro-skip lx-ready';
            // safety net: page content must never wait on the intro
            setTimeout(function () { h.classList.add('lx-ready'); }, 5000);
        })(document);
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600&display=swap">

    {% set lx_wordmark = theme.settings.get('lx_wordmark', 'MAISON D7') %}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>

    {# LUXE: the palette and fonts are fixed by the design system (06-luxe/_tokens.scss).
       The merchant's chosen colour is still exposed for apps that want it. #}
    <style>
        :root {
            --lx-merchant-primary: {{ theme.color.primary }};
            --lx-wordmark: "{{ lx_wordmark|default(store.name)|replace({'"': ''}) }}";
        }
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
<body id="app" class="theme-raed overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  ">
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
{# LUXE: signature intro. Hidden by CSS when skipped; hides itself after 4.5s if JS fails. #}
<div class="lx-intro" id="lx-intro" aria-hidden="true">
    <div class="lx-intro__mark">
        {% if lx_wordmark %}
            {% for ch in lx_wordmark|split('') %}<span style="--i: {{ loop.index0 }}">{{ ch }}</span>{% endfor %}
        {% else %}
            <img src="{{ store.logo }}" alt="">
        {% endif %}
    </div>
    <div class="lx-intro__tag">{{ theme.settings.get('lx_intro_tagline', 'New Season') }}</div>
    <div class="lx-intro__progress">
        <span class="lx-intro__line"><i></i></span>
        <span class="lx-intro__pct">0</span>
    </div>
</div>
<script data-cfasync="false">
    (function (d, w) {
        var h = d.documentElement, el = d.getElementById('lx-intro');
        if (!el || h.classList.contains('lx-intro-skip')) { el && el.remove(); h.classList.add('lx-ready'); return; }
        try { sessionStorage.setItem('lx-intro-seen', '1'); } catch (e) {}

        var reduced = w.matchMedia && w.matchMedia('(prefers-reduced-motion: reduce)').matches,
            MIN = reduced ? 300 : 1600,   // never shorter: lets the wordmark finish
            MAX = reduced ? 800 : 2800,   // never longer: shopping must not wait on us
            line = el.querySelector('.lx-intro__line'),
            pct = el.querySelector('.lx-intro__pct'),
            start = Date.now(), loaded = false, finished = false, shown = 0;

        h.classList.add('lx-intro-active');
        w.addEventListener('load', function () { loaded = true; });
        setTimeout(finish, MAX + 200); // rAF pauses in background tabs

        function finish() {
            if (finished) return;
            finished = true;
            line.style.setProperty('--p', 1); pct.textContent = '100';
            setTimeout(function () {
                el.classList.add('is-done');
                h.classList.add('lx-ready');
                h.classList.remove('lx-intro-active');
                setTimeout(function () { el.remove(); }, 1200);
            }, 180);
        }

        (function tick() {
            if (finished) return;
            var t = Date.now() - start,
                target = loaded ? Math.min(1, t / MIN) : Math.min(0.9, t / MAX);
            shown += (target - shown) * 0.18;
            line.style.setProperty('--p', shown.toFixed(3));
            pct.textContent = Math.round(shown * 100);
            if ((loaded && t >= MIN) || t >= MAX) return finish();
            w.requestAnimationFrame(tick);
        })();
    })(document, window);
</script>
{# LUXE: welcome / promotion dialog — every field is a theme setting (twilight.json → lx_promo_*) #}
{% if theme.settings.get('lx_promo_enabled', true) %}
  {% set promo_img = theme.settings.get('lx_promo_image') %}
  {% set promo_code = theme.settings.get('lx_promo_code') %}
  {% set promo_ends = theme.settings.get('lx_promo_ends') %}
  {% set promo_cta = theme.settings.get('lx_promo_cta_text', 'تسوّقي الآن') %}
  {% set promo_url = theme.settings.get('lx_promo_cta_url') %}
  <div class="lx-promo {{ promo_img ? 'lx-promo--media' : '' }}" id="lx-promo" role="dialog" aria-modal="true" aria-labelledby="lx-promo-title" hidden
       data-delay="{{ theme.settings.get('lx_promo_delay', 4) }}"
       data-days="{{ theme.settings.get('lx_promo_days', 1) }}"
       data-ends="{{ promo_ends }}"
       data-key="{{ (promo_code ~ '|' ~ promo_ends ~ '|' ~ theme.settings.get('lx_promo_title', ''))|url_encode }}">
    <div class="lx-promo__backdrop" data-lx-promo-close></div>
    <div class="lx-promo__panel">
      <button type="button" class="lx-promo__close" data-lx-promo-close aria-label="{{ trans('blocks.luxe.close') }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>
      {% if promo_img %}
        <figure class="lx-promo__media"><img src="{{ promo_img }}" alt="" loading="lazy"></figure>
      {% endif %}
      <div class="lx-promo__body">
        {% if theme.settings.get('lx_promo_eyebrow', 'مرحباً بكِ') %}<span class="lx-eyebrow">{{ theme.settings.get('lx_promo_eyebrow', 'مرحباً بكِ') }}</span>{% endif %}
        <h2 class="lx-promo__title lx-display" id="lx-promo-title">{{ theme.settings.get('lx_promo_title', 'خصم ترحيبي على طلبك الأول') }}</h2>
        {% set promo_text = theme.settings.get('lx_promo_text', 'اكتشفي المجموعة الجديدة واستمتعي بتجربة تسوّق هادئة وأنيقة.') %}
        {% if promo_text %}<p class="lx-promo__text">{{ promo_text }}</p>{% endif %}

        {% if promo_ends %}
          <div class="lx-promo__timer" data-lx-countdown="{{ promo_ends }}" aria-live="off">
            <span class="lx-promo__timer-label">{{ trans('blocks.luxe.ends_in') }}</span>
            <div class="lx-promo__timer-units">
              <span><b data-u="d">00</b><small>{{ trans('blocks.luxe.days') }}</small></span>
              <span><b data-u="h">00</b><small>{{ trans('blocks.luxe.hours') }}</small></span>
              <span><b data-u="m">00</b><small>{{ trans('blocks.luxe.minutes') }}</small></span>
              <span><b data-u="s">00</b><small>{{ trans('blocks.luxe.seconds') }}</small></span>
            </div>
          </div>
        {% endif %}

        {% if promo_code %}
          <div class="lx-promo__code">
            <span class="lx-promo__code-value" dir="ltr">{{ promo_code }}</span>
            <button type="button" class="lx-promo__copy" data-lx-copy="{{ promo_code }}"
                    data-copied="{{ trans('blocks.luxe.copied') }}">{{ trans('blocks.luxe.copy') }}</button>
          </div>
        {% endif %}

        {% if promo_cta and promo_url %}
          <a href="{{ promo_url }}" class="lx-btn lx-promo__cta" data-lx-promo-close>{{ promo_cta }}</a>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {% block content %}{% endblock %}
    </main>
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
